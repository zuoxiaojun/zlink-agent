  "include": ["agent", "backend"],
  "exclude": ["**/node_modules", "**/__pycache__", "**/.venv"],
  "typeCheckingMode": "standard",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "warning",
  "pythonVersion": "3.11",
  "pythonPlatform": "All",
  "venvPath": ".",
  "venv": ".venv"
}
